# Copy to .env for Docker Compose. Never commit .env.
# Use a URL-safe random password (no @, :, / or other URL delimiters).
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOE_ENCRYPTION_KEY=
# Local Docker defaults. For public deployment set both to true and use HTTPS.
MOE_PRODUCTION=false
MOE_COOKIE_SECURE=false
MOE_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Exact trusted hosts only; add your dedicated Hugging Face endpoint hostname here.
MOE_PROVIDER_HOSTS=api.openai.com,router.huggingface.co,host.docker.internal
MOE_HTTP_PROVIDER_HOSTS=host.docker.internal
